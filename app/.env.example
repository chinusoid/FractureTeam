# Copy to .env.local for local development. On Vercel set the same names in Project Settings -> Environment Variables.
# Never commit real values. None of these may start with NEXT_PUBLIC_ (they are server-only).

# --- AI provider ---------------------------------------------------------------
OPENAI_API_KEY=sk-replace-me
# Model id. Check first that your key has access (see README, "Check the model").
OPENAI_MODEL=gpt-6-luna
# low | medium | high, or "none" for a model without the reasoning parameter.
OPENAI_REASONING_EFFORT=low
# Optional: alternative API base URL (default https://api.openai.com/v1).
# OPENAI_BASE_URL=
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=25000

# Master switch. false = assistant off, manual planning keeps working (redeploy to apply on Vercel).
AI_ENABLED=true
# Local development and tests only: deterministic fake model. Ignored (refused) in production.
AI_MOCK=0

# --- Usage limits (required in production) -------------------------------------
# Upstash Redis REST credentials (Upstash console -> your database -> REST API).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
# A database created from Vercel (Storage -> Upstash for Redis) sets KV_REST_API_URL and KV_REST_API_TOKEN instead;
# those names are read too, so nothing has to be copied.
# Development only: keep counters in memory instead of Upstash. Ignored in production.
# QUOTA_MODE=memory

# Global spend cap for one UTC day, in USD. When reached, the assistant pauses until midnight UTC.
AI_DAILY_BUDGET_USD=5
# Worst-case cost reserved before each request; settled with real token usage afterwards.
AI_MAX_COST_PER_REQUEST_USD=0.05
# The model's list price in USD per 1M tokens. These are gpt-6-luna's (OpenAI model page, 14 Nov 2026).
# Change them together with OPENAI_MODEL: the daily budget is computed from these numbers.
AI_INPUT_PRICE_PER_MTOK=0.1
AI_OUTPUT_PRICE_PER_MTOK=0.5
# Soft limit per IP per minute (the venue network is shared, keep it generous).
AI_IP_PER_MINUTE=30
# Requests per browser per UTC day.
AI_CLIENT_PER_DAY=60
# Assistant questions per browser per UTC day on the free plan. Above it the app offers Covered Plus
# (free during early access), which raises the limit to AI_CLIENT_PER_DAY. Setup review is not counted.
AI_FREE_PER_DAY=5

# --- Origin check -------------------------------------------------------------
# Extra allowed origins, comma-separated (the deployment's own host is always allowed).
# ALLOWED_ORIGINS=https://your-app.vercel.app
